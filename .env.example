# ==========================================
# NEXORA ENTERPRISE CONFIGURATION
# Copy this file to `apps/backend/.env` and `apps/frontend/.env`
# ==========================================

# ------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
API_VERSION=v1

# ------------------------------------------
# 2. DATABASE & CACHING
# ------------------------------------------
MONGODB_URI=mongodb://localhost:27017/Student-ecosystem
REDIS_URI=redis://localhost:6379

# ------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------
JWT_SECRET=your_super_secret_jwt_signature_key_here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_for_express
CORS_ORIGIN=http://localhost:5173

# Google OAuth (For Student/Faculty Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------
# 4. AI & MACHINE LEARNING
# ------------------------------------------
# Used for SmartResume, Auto-Grading, AI Mock Interviews
OPENAI_API_KEY=sk-your-openai-key
DEEPSEEK_API_KEY=your_deepseek_api_key

# ------------------------------------------
# 5. PAYMENT & DONATIONS
# ------------------------------------------
# Used for Alumni Donations, Club Treasury, Bounties
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ------------------------------------------
# 6. STORAGE & CDN
# ------------------------------------------
# Used for Portfolio uploads, 3D Assets, Resumes
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=nexora-assets-bucket

# ------------------------------------------
# 7. COMMUNICATION & NOTIFICATIONS
# ------------------------------------------
# Email (SendGrid / SMTP)
SENDGRID_API_KEY=SG.your_sendgrid_key
EMAIL_FROM=noreply@nexora.io

# SMS (Twilio for SOS Mesh / Event Alerts)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------
# 8. INTEGRATIONS
# ------------------------------------------
# GitHub API (For OpenSource Dashboard, Code Roast)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat

# WebRTC / Video (For Mentorship & Mock Interviews)
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
