/* admin-dashboard.css */

/* Light Theme (Default) */
:root, [data-theme="light"] {
  --admin-bg: #f8fafc;
  --admin-surface: rgba(255, 255, 255, 0.8);
  --admin-surface-solid: #ffffff;
  --admin-border: rgba(0, 0, 0, 0.08);
  --admin-border-light: rgba(0, 0, 0, 0.15);
  --admin-text-main: #0f172a;
  --admin-text-muted: #64748b;
  --admin-neon-purple: #9333ea;
  --admin-neon-blue: #0284c7;
  --admin-success: #059669;
  --admin-danger: #dc2626;
  --admin-radius: 16px;
  --admin-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
}

/* Dark Theme (matches the ultra-premium mockup) */
[data-theme="dark"] {
  --admin-bg: #090a15;
  --admin-surface: rgba(22, 23, 40, 0.65);
  --admin-surface-solid: #161728;
  --admin-border: rgba(255, 255, 255, 0.08);
  --admin-border-light: rgba(255, 255, 255, 0.15);
  --admin-text-main: #f8fafc;
  --admin-text-muted: #94a3b8;
  --admin-neon-purple: #c084fc;
  --admin-neon-blue: #22d3ee;
  --admin-success: #34d399;
  --admin-danger: #ef4444;
  --admin-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

/* Purple Theme (Premium Indigo) */
[data-theme="purple"] {
  --admin-bg: #1e1b4b;
  --admin-surface: rgba(49, 46, 129, 0.65);
  --admin-surface-solid: #2e1065;
  --admin-border: rgba(255, 255, 255, 0.1);
  --admin-border-light: rgba(255, 255, 255, 0.2);
  --admin-text-main: #ffffff;
  --admin-text-muted: #c7d2fe;
  --admin-neon-purple: #c084fc;
  --admin-neon-blue: #22d3ee;
  --admin-success: #34d399;
  --admin-danger: #ef4444;
  --admin-glass-shadow: 0 8px 32px rgba(17, 24, 39, 0.4);
}
  --admin-neon-purple: #c084fc;
  --admin-neon-blue: #22d3ee;
  --admin-success: #34d399;
  --admin-danger: #ef4444;
  --admin-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

.admin-theme-wrapper {
  background-color: var(--admin-bg) !important;
  color: var(--admin-text-main) !important;
  min-height: 100vh;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background-image: 
    radial-gradient(circle at 15% 50%, rgba(var(--admin-neon-purple), 0.05) 0%, transparent 50%),
    radial-gradient(circle at 85% 30%, rgba(var(--admin-neon-blue), 0.05) 0%, transparent 50%);
  background-attachment: fixed;
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* Glass Panels */
.admin-glass-panel {
  background: var(--admin-surface);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius);
  box-shadow: var(--admin-glass-shadow);
  transition: border-color 0.3s ease, background 0.3s ease;
}

.admin-glass-panel:hover {
  border-color: var(--admin-border-light);
}

/* Overriding Sidebar & Navbar for Admin Only */
.admin-theme-wrapper .nexora-sidebar, 
.admin-theme-wrapper .nexora-navbar {
  background: var(--admin-surface);
  border-color: var(--admin-border);
  backdrop-filter: blur(20px);
}

.admin-theme-wrapper .nexora-sidebar-logo-text {
  background: linear-gradient(90deg, var(--admin-text-main), var(--admin-neon-blue));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Sidebar Active Item */
.admin-theme-wrapper .sidebar-nav-item {
  color: var(--admin-text-muted);
  border: 1px solid transparent;
}

.admin-theme-wrapper .sidebar-nav-item:hover {
  background: rgba(128, 128, 128, 0.05);
  color: var(--admin-text-main);
}

.admin-theme-wrapper .sidebar-nav-item.active {
  background: transparent !important;
  border: 1px solid var(--admin-neon-blue) !important;
  box-shadow: inset 0 0 20px rgba(2, 132, 199, 0.1), 0 0 15px rgba(2, 132, 199, 0.05) !important;
  color: var(--admin-text-main) !important;
}

[data-theme="dark"] .admin-theme-wrapper .sidebar-nav-item.active {
  box-shadow: inset 0 0 20px rgba(34, 211, 238, 0.15), 0 0 15px rgba(34, 211, 238, 0.1) !important;
}

.admin-theme-wrapper .sidebar-nav-item.active svg {
  color: var(--admin-neon-blue) !important;
  filter: drop-shadow(0 0 4px rgba(2, 132, 199, 0.4));
}

[data-theme="dark"] .admin-theme-wrapper .sidebar-nav-item.active svg {
  filter: drop-shadow(0 0 4px rgba(34, 211, 238, 0.6));
}

/* Typography Overrides */
.admin-theme-wrapper h1, 
.admin-theme-wrapper h2, 
.admin-theme-wrapper h3, 
.admin-theme-wrapper h4, 
.admin-theme-wrapper h5, 
.admin-theme-wrapper h6 {
  color: var(--admin-text-main) !important;
}

.admin-theme-wrapper .text-muted {
  color: var(--admin-text-muted) !important;
}

/* KPI Cards Layout */
.kpi-card {
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
}

.kpi-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.kpi-title {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--admin-text-main);
  opacity: 0.9;
}

.kpi-value-row {
  display: flex;
  align-items: flex-end;
  gap: 12px;
}

.kpi-value {
  font-size: 2.25rem;
  font-weight: 700;
  color: var(--admin-text-main);
  line-height: 1;
}

.kpi-change {
  font-size: 0.875rem;
  font-weight: 600;
  margin-bottom: 4px;
}

.kpi-change.positive { color: var(--admin-success); }
.kpi-change.negative { color: var(--admin-danger); }
.kpi-change.neutral { color: var(--admin-neon-blue); }

.kpi-icon-container {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(128, 128, 128, 0.1);
}

.kpi-icon-purple { color: var(--admin-neon-purple); }
.kpi-icon-blue { color: var(--admin-neon-blue); }

/* Recharts Customization for Admin */
.recharts-tooltip-wrapper .recharts-default-tooltip {
  background-color: var(--admin-surface-solid) !important;
  border: 1px solid var(--admin-border) !important;
  border-radius: 8px !important;
  box-shadow: var(--admin-glass-shadow) !important;
  color: var(--admin-text-main) !important;
}

.recharts-tooltip-item-name, .recharts-tooltip-item-value {
  color: var(--admin-text-main) !important;
}

/* Table overrides */
.admin-theme-wrapper .table {
  color: var(--admin-text-main);
  --bs-table-bg: transparent;
  --bs-table-color: var(--admin-text-main);
  margin-bottom: 0;
}
.admin-theme-wrapper .table th {
  border-bottom: 1px solid var(--admin-border);
  color: var(--admin-text-muted);
  font-weight: 500;
  font-size: 0.85rem;
  text-transform: capitalize;
  padding: 16px 20px;
}
.admin-theme-wrapper .table td {
  border-bottom: 1px solid var(--admin-border);
  padding: 16px 20px;
  vertical-align: middle;
}
.admin-theme-wrapper .table tbody tr:last-child td {
  border-bottom: none;
}
.admin-theme-wrapper .table tbody tr:hover {
  background-color: rgba(128, 128, 128, 0.05);
}

/* Search bar header override */
.admin-search-bar {
  background: var(--admin-surface) !important;
  border: 1px solid var(--admin-border) !important;
  color: var(--admin-text-main) !important;
  border-radius: 20px !important;
  padding-left: 40px !important;
}
.admin-search-bar::placeholder {
  color: var(--admin-text-muted) !important;
}
.admin-search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--admin-text-muted);
}
